diff --git a/components/bt/CMakeLists.txt b/components/bt/CMakeLists.txt
--- a/components/bt/CMakeLists.txt
+++ b/components/bt/CMakeLists.txt
@@ -31,7 +31,14 @@
     add_subdirectory(controller)
     list(APPEND srcs ${bt_ctrl_srcs})
     list(APPEND include_dirs ${bt_ctrl_include_dirs})
-    set(ldscripts ${bt_ctrl_ldscripts})
+    # ldgen splits spaces before resolving paths; use relative fragments.
+    set(ldscripts "")
