# Override some defaults so BT stack is enabled and
# Classic BT is enabled
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_BTDM_CTRL_PINNED_TO_CORE_1=y
CONFIG_BT_BLUEDROID_PINNED_TO_CORE_1=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y

CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_AVRCP_CT_COVER_ART_ENABLED=n
# Leave room for connection setup while a previous ACL is being torn down.
# The application still accepts only its selected speaker.
CONFIG_BT_ACL_CONNECTIONS=2
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=2
# Standard RX headroom: static buffers / dynamic buffers / Block Ack window = 6/16/6.
# Live-tested on ESP32 + Bose.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_LWIP_TCP_WND_DEFAULT=11520
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=n
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_NO_AFFINITY=n

# Finer ACK/recovery timer: default 250 ms is too coarse for a 1.486 s SBC ring.
CONFIG_LWIP_TCP_TMR_INTERVAL=50


# Bluetooth sinks receive server-encoded SBC; required for Bluetooth output.
CONFIG_BT_A2DP_USE_EXTERNAL_CODEC=y

# Required for reliable incoming SBC audio; enforced at compile time.
CONFIG_LWIP_TCP_QUEUE_OOSEQ=y
CONFIG_LWIP_TCP_SACK_OUT=y
